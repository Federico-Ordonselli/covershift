# Copy to .env. Values below match `supabase start` defaults.

# Runtime connection: low-privilege login role, member of `authenticated` only.
# Every query must go through the RLS transaction wrapper or it fails.
DATABASE_URL=postgresql://covershift_api:covershift_api_local@127.0.0.1:54322/postgres

# Privileged connection for migrations and seeding ONLY. Never given to the API process.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Password set on the covershift_api role by `pnpm db:migrate` (local/CI only;
# in deployed environments the role password is managed outside the app).
COVERSHIFT_API_DB_PASSWORD=covershift_api_local

SUPABASE_URL=http://127.0.0.1:54321
# Expected `iss` claim; defaults to ${SUPABASE_URL}/auth/v1.
# SUPABASE_JWT_ISSUER=
# Service-role key, used by the seed script only (auth.admin API).
SUPABASE_SECRET_KEY=

PORT=3000
