{
  "name": "@covershift/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node -r @swc-node/register scripts/migrate.ts",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:seed": "node -r @swc-node/register scripts/seed.ts",
    "openapi:update": "UPDATE_OPENAPI=1 vitest run --project integration test/openapi"
  },
  "dependencies": {
    "@covershift/shared": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "jose": "^6.2.12",
    "nestjs-cls": "^7.0.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@supabase/supabase-js": "^2.118.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
