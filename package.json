{
  "name": "covershift",
  "private": true,
  "description": "Multi-tenant shift scheduling and shift-swap platform",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:keys": "test -f supabase/signing_keys.json || (echo [] > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append --yes)",
    "db:start": "pnpm db:keys && supabase start && pnpm db:env",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "pnpm --filter @covershift/api db:migrate",
    "db:env": "node scripts/db-env.mjs",
    "db:seed": "pnpm --filter @covershift/api db:seed",
    "docker:smoke": "node scripts/docker-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "supabase": "2.121.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  }
}
