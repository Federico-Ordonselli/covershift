{
  "name": "covershift",
  "private": true,
  "description": "Multi-tenant shift scheduling and shift-swap platform",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:keys": "test -f supabase/signing_keys.json || (echo [] > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append --yes)",
    "db:start": "pnpm db:keys && supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "pnpm --filter @covershift/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "2.120.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
